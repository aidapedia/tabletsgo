// The app's own metadata schema (postgresql). Prisma Migrate owns its history
// in ./migrations; the baseline (0_baseline) is the shape legacy step v22 left.
//
// Edit this file and prisma/sqlite/schema.prisma together — the two
// declare the same models and differ only in provider — then create a migration
// for each engine (see the meta-schema skill). Rules carried over from the legacy
// steps: additive only, never DROP or rename, no NOT NULL column without a default.
// Superseded tables stay declared here (see DEPRECATED_TABLES in
// server/migrator/legacy/sqlite.js), or the next migration would drop them.
// The identity and authorization tables were dropped on purpose when Hayat took
// them over (migration 20261110000000_hayat_owns_identity).

// The app's query client (server/meta.js picks the one matching META_DB_TYPE).
// Generated, not committed: `npm run prisma:generate`.
generator client {
  provider = "prisma-client-js"
  output   = "../../server/generated/prisma-postgresql"
}

datasource db {
  provider = "postgresql"
}

model app_settings {
  key        String  @id
  value      String?
  updated_at BigInt?
}

model backup_runs {
  id            String  @id
  connection_id String
  schedule_id   String
  trigger_kind  String
  status        String
  error         String?
  uploads       String?
  started_at    BigInt
  finished_at   BigInt?
  ts            BigInt

  @@index([connection_id, started_at], map: "idx_backup_runs_conn_day")
}

model backup_schedules {
  id              String  @id
  connection_id   String  @unique
  frequency       String
  hour_of_day     BigInt?
  destination_ids String?
  retry_limit     BigInt? @default(0)
  retry_delay_sec BigInt? @default(60)
  retention_days  BigInt? @default(0)
  encrypt         BigInt? @default(0)
  enabled         BigInt? @default(1)
  next_run_at     BigInt?
  created_at      BigInt?
  updated_at      BigInt?
  include_config  BigInt? @default(0)
}

model connection_tables {
  id            String  @id
  connection_id String
  table_name    String
  folder_id     String?
  ts            BigInt?

  @@unique([connection_id, table_name])
  @@index([connection_id], map: "idx_connection_tables_conn")
}

model connections {
  id             String  @id
  data           String?
  created_at     BigInt?
  type           String?
  name           String?
  workspace_id   String?
  environment    String?
  folder         String?
  tags           String?
  credentials    String?
  schema_version BigInt?
  updated_at     BigInt?
  owner_id       String?
  max_sessions   BigInt? @default(0)
}

model dashboards {
  id            String  @id
  connection_id String
  name          String
  config        String?
  ts            BigInt?
  folder_id     String?
}

model domains {
  id            String  @id
  connection_id String
  name          String
  color         String?
  ts            BigInt?
}

model folders {
  id            String  @id
  connection_id String
  type          String
  name          String
  parent_id     String?
  ts            BigInt?
  color         String?
}

/// Pre-Prisma version marker (legacy steps v1–v22). Kept so an older image still
/// recognises the database; nothing reads it once Prisma owns the history.
model metadata_schema_version {
  version BigInt

  @@ignore
}

model query_history {
  id            String  @id
  connection_id String
  table_name    String?
  query         String
  status        String
  latency       BigInt?
  error         String?
  executor_id   String?
  executor_name String?
  ts            BigInt?
}

model saved_folders {
  id            String  @id
  connection_id String
  name          String
  ts            BigInt?
  parent_id     String?
}

model saved_queries {
  id            String  @id
  connection_id String
  name          String
  sql           String
  kind          String?
  ts            BigInt?
  folder_id     String?
  layout        String?
  created_by    String?
  updated_by    String?
  created_at    BigInt?
}

model schema_drafts {
  id           String  @id
  workspace_id String
  name         String
  db_type      String
  sql          String?
  created_by   String?
  ts           BigInt?
  layout       String?
  updated_by   String?
  created_at   BigInt?

  @@index([workspace_id], map: "idx_schema_drafts_workspace")
}

model schema_migrations {
  id            String  @id
  connection_id String
  version       BigInt
  forward_sql   String
  rollback_sql  String?
  reversible    BigInt
  status        String?
  executor_id   String?
  executor_name String?
  ts            BigInt?
}

model ssh_gateways {
  id               String  @id
  workspace_id     String
  name             String
  host             String
  port             BigInt?
  username         String?
  auth             String?
  key_id           String?
  host_fingerprint String?
  credentials      String?
  created_at       BigInt?
  updated_at       BigInt?
  transport        String?

  @@index([workspace_id], map: "idx_ssh_gateways_workspace")
}

model ssh_keys {
  id           String  @id
  workspace_id String
  name         String
  algorithm    String?
  public_key   String
  fingerprint  String?
  credentials  String?
  created_by   String?
  created_at   BigInt?
  updated_at   BigInt?

  @@index([workspace_id], map: "idx_ssh_keys_workspace")
}

model storage_destinations {
  id               String  @id
  workspace_id     String
  name             String
  endpoint         String?
  region           String?
  bucket           String
  path_prefix      String?
  force_path_style BigInt?
  credentials      String?
  created_at       BigInt?
  updated_at       BigInt?
}

model table_domains {
  id            String  @id
  connection_id String
  table_name    String
  domain_id     String
  ts            BigInt?

  @@unique([connection_id, table_name])
  @@index([connection_id], map: "idx_table_domains_conn")
}

model workflow_runs {
  id            String  @id
  workflow_id   String
  connection_id String
  trigger_kind  String
  status        String
  log           String?
  error         String?
  started_at    BigInt
  finished_at   BigInt?
  ts            BigInt

  @@index([connection_id, started_at], map: "idx_workflow_runs_conn_day")
}

model workflows {
  id               String  @id
  connection_id    String
  name             String
  graph            String?
  ts               BigInt?
  protected        BigInt? @default(0)
  schedule_enabled BigInt? @default(0)
  next_run_at      BigInt?
  folder_id        String?
}

model workspaces {
  id         String  @id
  name       String
  settings   String?
  created_at BigInt?
}
