{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/kurniajigunawan/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/kurniajigunawan/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/kurniajigunawan/js/tabletsgo/.codex/hooks/backend-docs-reminder.js'",
            "timeout": 10,
            "statusMessage": "Checking backend docs rule"
          }
        ]
      }
    ]
  }
}
