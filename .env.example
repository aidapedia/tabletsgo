# Copy to `.env` and adjust. Read by `docker compose` for variable substitution.

# Host port to expose the app on (container always listens on 3000).
PORT=3000

# REQUIRED. Encrypts connection credentials (host/port/username/password/…) at
# rest in the metadata DB (AES-256-GCM). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/changing this key makes existing connections' credentials unreadable.
ENCRYPTION_KEY=change-me

# Optional admin pre-seed. Leave these UNSET to use the in-browser first-run
# setup wizard (recommended). If set, an instance admin + workspace are seeded
# on a fresh metadata DB and the wizard is skipped. ADMIN_USERNAME is an email.
# NOTE: this seeds the *instance admin* only — no workspace. An admin by design
# holds no workspace access, so sign in and create the first workspace (naming
# its owner) from Administration > Workspaces before anyone can add connections.
# ADMIN_USERNAME=admin@example.com
# ADMIN_PASSWORD=change-me

# Optional SMTP — enables emailing member invites and password resets.
# These are only the fallback: an instance admin sets the mail server under
# Administration > Email (stored in the app DB, changeable without a redeploy),
# and that config wins over anything here. Mail is instance-wide — workspaces
# do not configure their own.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=secret
# SMTP_FROM=Tabletsgo <no-reply@example.com>
# SMTP_SECURE=false          # true for implicit TLS (port 465)

# Frontend API base URL, baked into the build. Leave as /api for the
# single-image deploy (API + static served on the same origin). Set to an
# absolute URL only for a split frontend/backend deploy.
VITE_API_URL=/api

# How long (ms) the pre-flight handshake waits for a database to answer before
# reporting a timeout. It runs while the user waits on the "Connect" button, so
# keep it short; raise it only for databases behind a slow tunnel/VPN.
# HANDSHAKE_TIMEOUT_MS=8000

# Sessions. Nothing to point at: logins are stored in the metadata DB and read
# through an in-process cache, so a restart never signs anyone out, and an
# open-connection session is held by the process owning the database handle
# (which is also why the cap below is enforced per replica).
# SESSION_TTL_MS=2592000000         # login lifetime, sliding (default 30 days)
# SESSION_IDLE_TTL_MS=900000        # idle time before an open database handle is
#                                   #   released (default 15 min)
# Instance-wide cap on concurrent sessions per connection — one session = one
# open connection to a database. 0 = unlimited. A workspace (Workspace >
# General) or an individual connection can set a lower/higher one.
# MAX_SESSIONS_PER_CONNECTION=0

# Sign-in brute-force protection. This many consecutive failures inside the
# window block the account; a failure older than the window doesn't count (the
# counter restarts). A block lasts until an instance admin lifts it in
# Administration > Users, unless LOGIN_LOCKOUT_MS gives it an expiry.
# An instance admin is never blocked indefinitely — nobody would be left to
# unblock them — so they get LOGIN_ADMIN_COOLDOWN_MS instead, which always
# expires on its own. Set it to 0 to leave admin sign-ins unthrottled.
# LOGIN_MAX_ATTEMPTS=5              # 0 disables account blocking entirely
# LOGIN_ATTEMPT_WINDOW_MS=900000    # 15 min
# LOGIN_LOCKOUT_MS=0                # 0 = until an admin unblocks
# LOGIN_ADMIN_COOLDOWN_MS=900000    # 15 min

# Set to "false" to disable the workflow scheduler (the minutely cron tick that
# fires workflows with an active hourly/daily schedule, including backups).
# Useful for local dev/CI so test data doesn't trigger real scheduled runs.
# WORKFLOW_SCHEDULER_ENABLED=false

# Which published image tag `docker compose` runs (and pulls on update).
TABLETSGO_TAG=latest

# In-app update checker. Defaults target the official image/repo; override only
# for a fork. The checker compares the running (version, sha) against the latest
# GitHub Release + its release.json contract.
# UPDATE_IMAGE=ghcr.io/aidapedia/tabletsgo
# UPDATE_REPO=aidapedia/tabletsgo
#
# Apply method — auto-detected, no config required:
#   - Docker socket mounted → one-click self-update from the wizard. Just mount
#     the socket in docker-compose.yml (see the commented volume there). Works
#     best when the container runs a moving tag like :latest (TABLETSGO_TAG=latest).
#   - Otherwise → the wizard shows a manual `docker compose pull` command.
# UPDATE_HELPER_IMAGE=docker:cli   # image used to perform the Docker self-update swap
#
# Default for the per-user "auto-check for updates" toggle (Settings > Updates).
# Off unless set truthy (1/true/yes/on); users can override it per browser. Leave
# off when an orchestrator (e.g. Coolify) manages updates.
# UPDATE_AUTO_CHECK=false
