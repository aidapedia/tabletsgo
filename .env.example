# Copy to `.env` and adjust. Read by `docker compose` for variable substitution.

# Host port to expose the app on (container always listens on 3000).
PORT=3000

# REQUIRED. Encrypts connection credentials (host/port/username/password/…) at
# rest in the metadata DB (AES-256-GCM). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/changing this key makes existing connections' credentials unreadable.
ENCRYPTION_KEY=change-me

# REQUIRED. Sign-in and authorization are Hayat's (https://github.com/aidapedia/hayat):
# people sign in there, and every permission is asked of its service API.
# The server refuses to start without the first five; `hayat import` prints
# them — see README → Hayat. Developing against Hayat's source (../hayat)?
# `npm run dev:hayat` fills these in for you.
# HAYAT_ISSUER=https://auth.example.com           # Hayat's auth role (public URL)
# HAYAT_API_URL=http://hayat-api:7443             # Hayat's api role (reachable from here only)
# HAYAT_CLIENT_ID=                                # tabletsgo's service credentials in Hayat
# HAYAT_CLIENT_SECRET=
# HAYAT_WEB_CLIENT_ID=                            # the public client the browser signs in with
# HAYAT_CONSOLE_URL=https://hayat.example.com     # optional: where "Manage in Hayat" links point
# HAYAT_AUTH_URL=http://hayat-auth:8443           # optional: the auth role as this server reaches it,
#                                                 #   when not at HAYAT_ISSUER (default: HAYAT_ISSUER)

# App metadata (connections, saved queries, workspace settings, …).
# Default SQLite needs no other service and stores data in /app/data/app.db.
# To use PostgreSQL, set both values below. For the bundled optional service,
# also set META_POSTGRES_PASSWORD and start with:
#   docker compose --profile postgresql up -d
# META_DB_TYPE=postgresql
# META_DATABASE_URL=postgresql://tabletsgo:your-password@metadata-postgres:5432/tabletsgo
# META_POSTGRES_PASSWORD=your-password
# Use a dedicated empty PostgreSQL database/schema for a new installation.

# Optional SMTP — for tabletsgo's own notices (backup failures, locked
# connections). Invites and password resets are sent by Hayat.
# These are only the fallback: an instance admin sets the mail server under
# Administration > Email (stored in the app DB, changeable without a redeploy),
# and that config wins over anything here. Mail is instance-wide — workspaces
# do not configure their own.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=secret
# SMTP_FROM=Tabletsgo <no-reply@example.com>
# SMTP_SECURE=false          # true for implicit TLS (port 465)

# The address people reach this instance at, e.g. https://db.acme.com. Set it
# behind a reverse proxy: emailed links use it, and otherwise come from the
# request. Register <this>/callback as the redirect of HAYAT_WEB_CLIENT_ID.
# PUBLIC_URL=

# Frontend API base URL, baked into the build. Leave as /api for the
# single-image deploy (API + static served on the same origin). Set to an
# absolute URL only for a split frontend/backend deploy.
VITE_API_URL=/api

# How long (ms) the pre-flight handshake waits for a database to answer before
# reporting a timeout. It runs while the user waits on the "Connect" button, so
# keep it short; raise it only for databases behind a slow tunnel/VPN.
# HANDSHAKE_TIMEOUT_MS=8000

# Connection sessions — one session = one open connection to a database, held
# by the process that owns the handle (so the cap below is per replica). A login
# is a Hayat token, so there is no login lifetime to set here.
# SESSION_IDLE_TTL_MS=900000        # idle time before an open database handle is
#                                   #   released (default 15 min)
# Instance-wide cap on concurrent sessions per connection. 0 = unlimited. A
# workspace (Workspace > General) can set its own.
# MAX_SESSIONS_PER_CONNECTION=0

# Set to "false" to disable the workflow scheduler (the minutely cron tick that
# fires workflows with an active hourly/daily schedule, including backups).
# Useful for local dev/CI so test data doesn't trigger real scheduled runs.
# WORKFLOW_SCHEDULER_ENABLED=false
