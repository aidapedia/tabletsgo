# Copy to `.env` and adjust. Read by `docker compose` for variable substitution.

# Host port to expose the app on (container always listens on 3000).
PORT=3000

# Admin user seeded on first run (only applied to a fresh metadata DB).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Frontend API base URL, baked into the build. Leave as /api for the
# single-image deploy (API + static served on the same origin). Set to an
# absolute URL only for a split frontend/backend deploy.
VITE_API_URL=/api
