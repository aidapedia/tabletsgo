# Copy to `.env` and adjust. Read by `docker compose` for variable substitution.

# Host port to expose the app on (container always listens on 3000).
PORT=3000

# REQUIRED. Encrypts connection credentials (host/port/username/password/…) at
# rest in the metadata DB (AES-256-GCM). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/changing this key makes existing connections' credentials unreadable.
CONNECTION_ENCRYPTION_KEY=change-me

# Optional admin pre-seed. Leave these UNSET to use the in-browser first-run
# setup wizard (recommended). If set, an admin + workspace are seeded on a
# fresh metadata DB and the wizard is skipped. ADMIN_USERNAME is an email.
# ADMIN_USERNAME=admin@example.com
# ADMIN_PASSWORD=change-me
# WORKSPACE_NAME=My Workspace

# Optional SMTP — enables emailing member invites. Also configurable per
# workspace in the UI (workspace settings override these env fallbacks).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=secret
# SMTP_FROM=Tabletsgo <no-reply@example.com>
# SMTP_SECURE=false          # true for implicit TLS (port 465)

# Frontend API base URL, baked into the build. Leave as /api for the
# single-image deploy (API + static served on the same origin). Set to an
# absolute URL only for a split frontend/backend deploy.
VITE_API_URL=/api
