{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/backend-docs-reminder.js",
            "timeout": 10,
            "statusMessage": "Checking backend docs rule"
          }
        ]
      }
    ]
  }
}
