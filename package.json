{
  "name": "tabletsgo",
  "private": true,
  "version": "0.25.0",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "server": "npm run prisma:generate && npm run migrate && node --env-file-if-exists=.env server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "prisma": "node --env-file-if-exists=.env node_modules/prisma/build/index.js",
    "prisma:generate": "prisma generate --schema prisma/sqlite/schema.prisma --config prisma/generate.config.mjs && prisma generate --schema prisma/postgresql/schema.prisma --config prisma/generate.config.mjs",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run prisma:generate",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "start": "node server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.3",
    "@dagrejs/dagre": "^3.0.0",
    "@lezer/highlight": "^1.2.3",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@uiw/react-codemirror": "^4.25.10",
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "html-to-image": "^1.11.13",
    "ioredis": "^5.11.1",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.3",
    "prisma": "7.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.3",
    "react-router-dom": "^6.26.2",
    "reactflow": "^11.11.4",
    "sql-formatter": "^15.8.2",
    "sql.js": "^1.14.1",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "pg-native": "^3.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^8.2.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
