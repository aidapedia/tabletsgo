{
  "name": "tabletsgo",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "console"
  ],
  "scripts": {
    "dev": "npm run dev -w console",
    "server": "npm run prisma:generate && node --env-file-if-exists=.env server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "hayat:bundle": "node --env-file-if-exists=.env scripts/hayat-bundle.js",
    "hayat:remap": "node --env-file-if-exists=.env scripts/hayat-remap.js",
    "prisma": "node --env-file-if-exists=.env node_modules/prisma/build/index.js",
    "prisma:generate": "prisma generate --schema prisma/sqlite/schema.prisma --config prisma/generate.config.mjs && prisma generate --schema prisma/postgresql/schema.prisma --config prisma/generate.config.mjs",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "dev:hayat": "sh scripts/dev/hayat.sh setup && concurrently -k -n hayat,hayat-console,server,web -c magenta,blue,green,cyan \"sh scripts/dev/hayat.sh serve\" \"sh scripts/dev/hayat.sh console\" \"sh scripts/dev/hayat.sh wait && npm run server\" \"npm run dev\"",
    "build": "npm run build -w console",
    "typecheck": "npm run typecheck -w console",
    "pretest": "npm run prisma:generate",
    "test": "node --test tests/*.test.js",
    "preview": "npm run preview -w console",
    "start": "node server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "avsc": "^5.7.9",
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ioredis": "^5.11.1",
    "jose": "^6.2.15",
    "kafkajs": "2.2.4",
    "mysql2": "^3.24.6",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.3",
    "prisma": "7.10.0",
    "protobufjs": "^8.8.1",
    "ssh2": "^1.17.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "pg-native": "^3.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "concurrently": "^8.2.2"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
